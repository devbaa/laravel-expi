includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: 10

    paths:
        - src
        - tests

    # Reflection-based introspection deliberately probes dynamic shapes, so a
    # few Laravel-internal nuances are not worth fighting the analyser over.
    treatPhpDocTypesAsCertain: false

    # Larastan / strict-rules opt-ins on top of level 10.
    checkUninitializedProperties: true
    checkBenevolentUnionTypes: true
    reportAnyTypeWideningInVarTag: true
